# Base de datos Postgres (Neon o Supabase). Copia la cadena de conexión completa.
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require

# Acceso al panel de analista
ADMIN_PASSWORD=pon-una-clave-larga-y-unica
# Cadena aleatoria larga para firmar la sesión (por ejemplo: openssl rand -hex 32)
SESSION_SECRET=

# Análisis con IA, capa gratuita de Gemini (aistudio.google.com > Get API key). No actives facturación.
GEMINI_API_KEY=
# Opcional: modelo principal y de respaldo (cuando se agota el límite diario del principal)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Correo de aviso (resend.com > API Keys)
RESEND_API_KEY=
ADMIN_EMAIL=tu-correo@ejemplo.com
# Remitente. Sin dominio propio verificado en Resend usa: onboarding@resend.dev
EMAIL_FROM=Briebluunt <onboarding@resend.dev>

# Nombre que ven los clientes y que aparece en el aviso de datos (Ley 1581)
BUSINESS_NAME=Bluuntgroup
# Correo donde los clientes pueden pedir consultar o borrar sus datos
PRIVACY_EMAIL=tu-correo@ejemplo.com
# URL pública de la app, sin barra final (por ejemplo https://tu-briefing.netlify.app)
APP_URL=http://localhost:3000
